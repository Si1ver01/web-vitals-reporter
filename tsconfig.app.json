{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": false,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
