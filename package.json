{
  "name": "web-vitals-reporter",
  "version": "0.1.0",
  "description": "A small browser-first Web Vitals reporter with safe, pluggable delivery adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Si1ver01/web-vitals-reporter"
  },
  "type": "module",
  "private": false,
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "SECURITY.md",
    "docs",
    "examples"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "dependencies": {
    "web-vitals": "^5.1.0"
  },
  "scripts": {
    "build": "node scripts/run-commands.mjs build tsup",
    "typecheck": "node scripts/run-commands.mjs typecheck tsc -p tsconfig.app.json --noEmit",
    "test": "node scripts/run-commands.mjs test vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/run-commands.mjs lint eslint src tests --max-warnings=0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "pack:check": "node scripts/check-package.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "security:check": "node scripts/check-security-dependencies.mjs",
    "release:check-tag": "node scripts/check-release-tag.mjs",
    "verify": "node scripts/run-commands.mjs verify npm run format:check ::: npm run lint ::: npm run security:check ::: npm run typecheck ::: npm run test ::: npm run build ::: npm run pack:check ::: npm run docs:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.0.0",
    "globals": "^17.9.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
